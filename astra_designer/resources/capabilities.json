  "feedback.classify@1": {
    "class": "ClassifyFeedbackAgent",
    "inputs": {
      "records": "feedback_records"
    },
    "outputs": {
      "classified": "classified_feedback"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "fallback"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "keywords"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "feedback.count@1": {
    "class": "CountFeedbackAgent",
