  "table.compute@1": {
    "class": "TableComputeAgent",
    "inputs": {},
    "outputs": {
      "result": "table_rows"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_schema",
        "steps"
      ],
      "properties": {
        "input_schema": {
          "type": "string",
          "minLength": 1
        },
        "rows_path": {
          "type": "string",
          "pattern": "^(/[^/]+)*$"
        },
        "lookup_schema": {
          "type": "string",
          "minLength": 1
        },
        "lookup_path": {
          "type": "string",
          "pattern": "^(/[^/]+)*$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "where"
                ],
                "properties": {
                  "op": {
                    "const": "filter"
                  },
                  "where": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "column",
                        "cmp"
                      ],
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1
                        },
                        "cmp": {
                          "enum": [
                            "eq",
                            "ne",
                            "gt",
                            "gte",
                            "lt",
                            "lte",
                            "contains",
                            "in",
                            "empty",
                            "not_empty"
                          ]
                        },
                        "value": {}
                      }
                    }
                  },
                  "mode": {
                    "enum": [
                      "all",
