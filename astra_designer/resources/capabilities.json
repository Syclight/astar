            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "llm.transform@1": {
    "class": "ConfiguredLLMAgent",
    "inputs": {},
    "outputs": {},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "input_schemas",
        "output_schemas"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 20000
        },
        "input_schemas": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_schemas": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "max_input_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "optional_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 131072,
          "description": "本 Agent 单次回复的最大 token 数；一次要写很长的内容（如整章正文）时调大"
        }
      }
    }
  },
  "document.write@1": {
    "class": "DocumentWriterAgent",
    "inputs": {},
    "outputs": {},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_schema",
        "formats",
        "filename"
      ],
      "properties": {
        "key_namespace": {"type": "string", "minLength": 1},
        "key_field": {"type": "string", "minLength": 1},
        "object_context": {"type": "boolean", "description": "使用 object.resolve 的 object 输入统一状态和文档归档身份"},
        "input_schema": {
          "type": "string",
          "minLength": 1
        },
        "text_path": {
          "type": "string",
          "pattern": "^(/[^/]+)*$"
        },
        "title_path": {
          "type": "string",
          "pattern": "^(/[^/]+)+$"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "txt",
              "md",
              "docx",
              "pdf"
            ]
          }
        },
        "format_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?:[^\\\\/:*?\"<>|{}]|\\{[^{}]*\\})+$",
          "description": "文件名（不含扩展名）；可含 {task_input 字段} 与 {/被写入数据中的 JSON 指针}，如 {title}_第{/chapter_number}章"
        },
        "section_title_key": {
          "type": "string",
          "minLength": 1
        },
        "section_text_key": {
          "type": "string",
          "minLength": 1
        },
        "per_item": {
          "type": "boolean",
          "description": "text_path 指向数组时每项写一个文件（如每章一个文件），filename 中的 {/字段} 取该项"
        },
        "accumulate": {
          "type": "boolean",
          "description": "把本次文本追加到以前各次运行写过的同名文稿之后（如全书），保存在 output/documents"
        },
        "reset_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "reset_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  },
  "table.read@1": {
    "class": "TableReadAgent",
    "inputs": {
      "brief": "task_input"
    },
    "outputs": {
      "rows": "table_rows"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_field"
      ],
      "properties": {
        "path_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "header_row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "表头在第几行（从 1 开始）；省略时自动查找"
        },
        "source_column": {
          "type": "string",
          "minLength": 1,
          "description": "path_field 为多个文件时，记录每行来自哪个文件的列名（默认“来源文件”）"
        }
      }
    }
  },
  "table.write@1": {
    "class": "TableWriteAgent",
    "inputs": {},
    "outputs": {},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_schema",
        "formats",
        "filename"
      ],
      "properties": {
        "input_schema": {
          "type": "string",
          "minLength": 1
        },
        "rows_path": {
          "type": "string",
          "pattern": "^(/[^/]+)*$"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "csv",
              "xlsx"
            ]
          }
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[^\\[\\]:*?/\\\\]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?:[^\\\\/:*?\"<>|{}]|\\{[^{}]*\\})+$",
          "description": "文件名（不含扩展名）；可含 {task_input 字段} 与 {/被写入数据中的 JSON 指针}，如 {title}_第{/chapter_number}章"
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 31,
                "pattern": "^[^\\[\\]:*?/\\\\]+$"
              },
              "rows_path": {
                "type": "string",
                "pattern": "^(/[^/]+)*$"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "description": "写成一个 xlsx 的多个工作表，每个工作表取 rows 数据中的一个数组"
        }
      }
    }
  },
  "http.request@1": {
    "class": "HttpRequestAgent",
    "inputs": {},
    "outputs": {
      "response": "http_response"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^/{}\\s]+(/\\S*)?$",
          "description": "固定主机；路径或查询可含 {task_input 字段} 和 {env:环境变量名}（密钥）"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "请求头；密钥写成 {env:环境变量名}"
        },
        "auth_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "auth_scheme": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$"
        },
        "body_schema": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "ok_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 300,
            "maximum": 599
          },
          "description": "这些状态码作为正常结果交给下一步（如 404 表示查无此人），不算失败"
        },
        "each_path": {
          "type": "string",
          "pattern": "^(/[^/]+)*$",
          "description": "body 数据中的数组：每项发一次请求（如逐个通知客户），url 中的 {/字段} 取该项；输出为逐条结果数组"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "each_path 最多处理的条数（默认 200）"
        },
        "page_param": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
          "description": "分页查询参数名（如 page）：从第 1 页起逐页请求，直到某页为空"
        },
        "first_page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "items_path": {
          "type": "string",
          "pattern": "^(/[^/]+)*$",
          "description": "分页时每页响应中条目数组的位置，如 /data/items"
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "body_format": {
          "enum": [
            "json",
            "form"
          ],
          "description": "请求体格式：json（默认）或 form（表单）"
        }
      }
    }
  },
