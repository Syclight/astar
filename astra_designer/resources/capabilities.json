          "description": "透明背景（RGBA），用于 Logo、贴纸、抠图"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?:[^\\\\/:*?\"<>|{}]|\\{[^{}]*\\})+$",
          "description": "文件名（不含扩展名），可含 {task_input 字段}；提示词为对象数组时可含 {/该项的字段}"
        },
        "max_images": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "本步骤一次运行最多生成的图片数，默认 20"
        },
        "image_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "每次运行提交的图片路径（string 或 string 数组）"
        },
        "images_schema": {
          "enum": [
            "image_files"
          ],
          "description": "编辑上游 image.generate / image.edit 生成的图片（images 端口）"
        },
        "each_image": {
          "type": "boolean",
          "description": "每张图片分别编辑（如批量换背景）；否则全部图片作为参考合成一张（默认最多 4 张）"
        }
      }
    }
  }
}
