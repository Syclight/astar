  "state.load@1": {
    "class": "StateLoadAgent",
    "inputs": {},
    "outputs": {
      "state": "stored_state"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_namespace": {"type": "string", "minLength": 1},
        "object_context": {"type": "boolean", "description": "使用 object.resolve 的 object 输入统一状态和文档归档身份"},
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9一-鿿][A-Za-z0-9_\\-一-鿿]{0,63}$"
        },
        "key_field": {
          "description": "已有外部业务编号所在的 task_input 字段，内部解析为对象 ID；缺失时不从模型补造",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value_schema": {
          "type": "string",
          "minLength": 1
        },
        "reset_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "reset_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "require_found": {
          "type": "boolean",
          "description": "不是从头开始（reset）时，找不到保存的状态就报错并列出已有的键，而不是当作新的开始；用于凭编号继续"
        }
      }
    }
  },
  "state.save@1": {
    "class": "StateSaveAgent",
    "inputs": {},
    "outputs": {
      "record": "state_record"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_schema"
      ],
      "properties": {
        "key_namespace": {"type": "string", "minLength": 1},
        "object_context": {"type": "boolean", "description": "使用 object.resolve 的 object 输入统一状态和文档归档身份"},
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9一-鿿][A-Za-z0-9_\\-一-鿿]{0,63}$"
        },
        "key_field": {
          "description": "已有外部业务编号所在的 task_input 字段，内部解析为对象 ID；缺失时不从模型补造",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value_schema": {
          "type": "string",
          "minLength": 1
        },
        "append_path": {
          "type": "string",
          "pattern": "^(/[^/]+)+$",
          "description": "value 中的数组字段（如 /chapter_summaries）：模型只给本次新增的条目，程序追加到已保存的列表"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "append_path 列表只保留最近这么多条"
        },
        "reset_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "reset_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "key_path": {
          "type": "string",
          "pattern": "^(/[^/]+)+$",
          "description": "仅在 object_context=true 时，将程序持有的 object.id 回填到业务数据的字符串字段；不从模型输出生成身份"
        }
      }
    }
  },
