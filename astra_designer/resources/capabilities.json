{
  "object.resolve@1": {
    "class": "ObjectResolveAgent",
    "inputs": {"brief": "task_input"},
    "outputs": {"object": "business_object"},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "anyOf": [{"required": ["mode_field", "id_field"]}, {"required": ["key_field"]}],
      "properties": {
        "key_field": {"type": "string", "minLength": 1},
        "key_namespace": {"type": "string", "minLength": 1},
        "require_found": {"type": "boolean"},
        "mode_field": {"type": "string", "minLength": 1},
        "id_field": {"type": "string", "minLength": 1},
        "new_value": {"type": "string", "minLength": 1},
        "continue_value": {"type": "string", "minLength": 1}
      }
    }
  },
  "feedback.read@1": {
    "class": "ReadFeedbackAgent",
    "inputs": {},
    "outputs": {
      "records": "feedback_records"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
