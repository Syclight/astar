{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "items",
    "issues",
    "questions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "pattern": "\\S"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "statement",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "goal",
              "actor",
              "input",
              "output",
              "rule",
              "constraint",
              "preference",
              "scope",
              "acceptance",
              "scenario"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turn",
                "quote"
              ],
              "properties": {
                "turn": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ISS-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "ambiguity",
              "missing",
              "conflict",
              "assumption"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "question"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S"
          }
        }
      }
    },
    "team_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "options",
        "recommended_id",
        "reason"
      ],
      "properties": {
        "budget_mode": {
          "enum": [
            "suggest",
            "fixed",
            "unlimited"
          ]
        },
        "target_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "budget_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turn",
              "quote"
            ],
            "properties": {
              "turn": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000,
                "pattern": "\\S"
              }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "roles",
              "deliverables",
              "tradeoffs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "tokens": {
                "type": "integer",
                "minimum": 1
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "responsibility",
                    "requirement_ids",
                    "priority"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "responsibility": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3000
                    },
                    "model_strategy": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3000
                    },
                    "calls": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "input_tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "requirement_ids": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": {
                        "type": "string"
                      }
                    },
                    "priority": {
                      "enum": [
                        "delivery",
                        "review",
                        "exploration"
                      ]
                    }
                  }
                }
              },
              "reserve_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "deliverables": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              },
              "tradeoffs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              },
              "convergence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              },
              "assumptions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              },
              "other_costs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              },
              "estimate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "workloads",
                  "reserve_tokens"
                ],
                "properties": {
                  "workloads": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "role_id",
                        "category",
                        "scope",
                        "input_tokens",
                        "output_tokens",
                        "calls",
                        "assumptions"
                      ],
                      "properties": {
                        "role_id": {
                          "type": "string"
                        },
                        "category": {
                          "enum": [
                            "workflow",
                            "deliverable"
                          ]
                        },
                        "scope": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 3000
                        },
                        "input_tokens": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "min",
                                "max"
                              ],
                              "properties": {
                                "min": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "max": {
                                  "type": "integer",
                                  "minimum": 0
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "output_tokens": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "min",
                                "max"
                              ],
                              "properties": {
                                "min": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "max": {
                                  "type": "integer",
                                  "minimum": 0
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "calls": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "min",
                                "max"
                              ],
                              "properties": {
                                "min": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                },
                                "max": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "assumptions": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 10,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 3000
                          }
                        }
                      }
                    }
                  },
                  "reserve_tokens": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "recommended_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "task_input": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "x-astra-required-when": {
          "type": "array",
          "minItems": 1,
          "description": "只在某个选项下才必填的字段，如 mode 为 new 时必填 genre、为 continue 时必填 work_id",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "values",
              "required"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean"
                  ]
                }
              },
              "required": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_missing": {
          "enum": [
            "ask",
            "error"
          ]
        },
        "confirm_before_run": {
          "type": "boolean"
        },
        "questions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "form",
          "requirement_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEL-[0-9]{3,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 2000
          },
          "form": {
            "enum": [
              "file",
              "data",
              "action"
            ]
          },
          "formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "txt",
                "md",
                "docx",
                "pdf",
                "csv",
                "xlsx",
                "image"
              ]
            }
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "form": {
                  "const": "file"
                }
              },
              "required": [
                "form"
              ]
            },
            "then": {
              "required": [
                "formats"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "formats"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "form": {
                  "const": "action"
                }
              },
              "required": [
                "form"
              ]
            },
            "then": {
              "required": [
                "evidence"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "evidence"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
