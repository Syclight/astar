{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "inputs",
    "stages",
    "acceptance"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "goal"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "goal": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "schema"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "agents"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/agent"
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "op",
              "value"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/pointer"
              },
              "op": {
                "const": "equals"
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "op"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/pointer"
              },
              "op": {
                "const": "artifact_exists"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "op",
              "value"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/pointer"
              },
              "op": {
                "const": "matches_schema"
              },
              "value": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "schemas": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "requirements": {
      "type": "object"
    },
    "traceability": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "team_assignment": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_framework": {
          "type": "string"
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "task_input": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_missing": {
          "enum": [
            "ask",
            "error"
          ]
        },
        "confirm_before_run": {
          "type": "boolean"
        },
        "questions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "pointer": {
      "type": "string",
      "pattern": "^/(status|data(?:/(?:[^~/]|~[01])*)+)$"
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identifier"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "inputs",
        "outputs",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "$ref": "#/$defs/bindings"
        },
        "outputs": {
          "$ref": "#/$defs/bindings"
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "task_input"
          ]
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}
